pect Image Manifest","category":"Container Registries"},{"command":"vscode-containers.registries.copyRemoteFullTag","title":"Copy Full Tag","category":"Container Registries"},{"command":"vscode-containers.registries.deleteImage","title":"Delete Image...","category":"Container Registries"},{"command":"vscode-containers.registries.deployImageToAzure","title":"Deploy Image to Azure App Service...","category":"Container Registries"},{"command":"vscode-containers.registries.deployImageToAca","title":"Deploy Image to Azure Container Apps...","category":"Container Registries"},{"command":"vscode-containers.registries.disconnectRegistry","title":"Disconnect","category":"Container Registries"},{"command":"vscode-containers.registries.genericV2.removeTrackedRegistry","title":"Disconnect from Generic Container Registry","category":"Container Registries"},{"command":"vscode-containers.registries.genericV2.addTrackedRegistry","title":"Connect to Generic Container Registry...","category":"Container Registries"},{"command":"vscode-containers.registries.dockerHub.openInBrowser","title":"Open in Browser","category":"Docker Hub"},{"command":"vscode-containers.registries.help","title":"Registries Help","category":"Container Registries","icon":"$(question)"},{"command":"vscode-containers.registries.logInToContainerCli","title":"Log In to container CLI","category":"Container Registries"},{"command":"vscode-containers.registries.logOutOfContainerCli","title":"Log Out of container CLI","category":"Container Registries"},{"command":"vscode-containers.registries.pullImage","title":"Pull Image","category":"Container Registries"},{"command":"vscode-containers.registries.pullRepository","title":"Pull Repository","category":"Container Registries"},{"command":"vscode-containers.registries.reconnectRegistry","title":"Re-enter credentials","category":"Container Registries"},{"command":"vscode-containers.registries.refresh","title":"Refresh","category":"Container Registries","icon":"$(refresh)"},{"command":"vscode-containers.volumes.configureExplorer","title":"Configure Explorer...","category":"Container Volumes","icon":"$(settings-gear)"},{"command":"vscode-containers.volumes.inspect","title":"Inspect","category":"Container Volumes"},{"command":"vscode-containers.volumes.prune","title":"Prune...","category":"Container Volumes","icon":"$(clear-all)"},{"command":"vscode-containers.volumes.refresh","title":"Refresh","category":"Container Volumes","icon":"$(refresh)"},{"command":"vscode-containers.volumes.remove","title":"Remove...","category":"Container Volumes"},{"command":"vscode-containers.help","title":"Container Help","category":"Containers","icon":"$(question)"},{"command":"vscode-containers.help.reportIssue","title":"Report Issue","category":"Containers"},{"command":"vscode-containers.help.openWalkthrough","title":"Open Container Tools Extension Walkthrough","category":"Containers"},{"command":"vscode-containers.chooseContainerRuntime","title":"Choose container runtime...","category":"Containers","icon":"$(tools)"},{"command":"vscode-containers.askCopilot","title":"Ask Copilot","category":"Containers"},{"command":"vscode-containers.contexts.use","title":"Use","category":"Docker Contexts","icon":"$(check)"},{"command":"vscode-containers.contexts.remove","title":"Remove...","category":"Docker Contexts"},{"command":"vscode-containers.contexts.inspect","title":"Inspect","category":"Docker Contexts"},{"command":"vscode-containers.contexts.configureExplorer","title":"Configure Explorer...","category":"Docker Contexts","icon":"$(settings-gear)"},{"command":"vscode-containers.contexts.refresh","title":"Refresh","category":"Docker Contexts","icon":"$(refresh)"},{"command":"vscode-containers.contexts.help","title":"Docker Context Help","category":"Docker Contexts","icon":"$(question)"},{"command":"vscode-containers.activateContainerRuntimeProviders","title":"Activate Container Runtime Providers...","category":"Containers"},{"command":"vscode-containers.activateRegistryProviders","title":"Activate Registry Providers...","category":"Containers"}],"views":{"containersView":[{"id":"vscode-containers.views.containers","name":"Containers","icon":"resources/ContainerTools.svg"},{"id":"vscode-containers.views.images","name":"Images","icon":"resources/ContainerTools.svg"},{"id":"vscode-containers.views.registries","name":"Registries","icon":"resources/ContainerTools.svg"},{"id":"vscode-containers.views.networks","name":"Networks","icon":"resources/ContainerTools.svg","visibility":"collapsed"},{"id":"vscode-containers.views.volumes","name":"Volumes","icon":"resources/ContainerTools.svg","visibility":"collapsed"},{"id":"vscode-containers.views.dockerContexts","name":"Docker Contexts","icon":"resources/ContainerTools.svg","visibility":"collapsed"},{"id":"vscode-containers.views.help","name":"Help and Feedback","icon":"resources/ContainerTools.svg"}]},"viewsContainers":{"activitybar":[{"icon":"resources/ContainerTools.svg","id":"containersView","title":"Containers"}]},"walkthroughs":[{"id":"containersStart","title":"Getting Started with Container Tools","featuredFor":["Dockerfile","Containerfile","compose.yaml","docker-compose.yml","docker-compose.yaml","compose.yml"],"description":"Learn about Docker and the Container Tools extension for Visual Studio Code","steps":[{"id":"chooseContainerRuntime","title":"Choose your Container Runtime","completionEvents":["onCommand:vscode-containers.chooseContainerRuntime"],"description":"The Container Tools extension supports multiple container runtimes. Choose the one you want to use - you can change this anytime.\n[Choose Container Runtime](command:vscode-containers.chooseContainerRuntime)","media":{"markdown":"resources/walkthroughs/empty.md"}},{"id":"openFolder","title":"Open a Workspace Folder","completionEvents":["onCommand:workbench.action.files.openFolder"],"when":"workspaceFolderCount == 0 && !isMac","description":"Open a workspace folder to get started with Container Tools extension features.\n[Open Folder](command:workbench.action.files.openFolder)","media":{"markdown":"resources/walkthroughs/empty.md"}},{"id":"openFolderMac","title":"Open a Workspace Folder","completionEvents":["onCommand:workbench.action.files.openFileFolder"],"when":"workspaceFolderCount == 0 && isMac","description":"Open a workspace folder to get started with Container Tools extension features.\n[Open Folder](command:workbench.action.files.openFileFolder)","media":{"markdown":"resources/walkthroughs/empty.md"}},{"id":"scaffold","title":"Add Docker Files to Workspace","completionEvents":["onCommand:vscode-containers.configure","onCommand:vscode-containers.configureCompose"],"when":"workspaceFolderCount > 0","description":"A Dockerfile contains the instructions to assemble an image containing your app and its dependencies. Using this image to run your app in a container creates a production-like, reproducible runtime environment.\n\nIntelliSense support for authoring your Dockerfile is provided.\n[Add Docker Files](command:vscode-containers.configure)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/1g-addDockerFiles.gif","altText":"Modifying Dockerfiles"}},{"id":"buildImage","title":"Build an Image","completionEvents":["onCommand:vscode-containers.images.build"],"when":"workspaceFolderCount > 0","description":"The Container Tools extension makes it simple to build your image.\n[Build Image](command:vscode-containers.images.build)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/2g-buildImage.gif","altText":"Building a container image"}},{"id":"runContainer","title":"Run a Container","completionEvents":["onCommand:vscode-containers.images.run","onCommand:vscode-containers.compose.up","onCommand:vscode-containers.compose.up.subset","onCommand:vscode-containers.compose.down.subset"],"description":"You can run any image on your system including those you've built with a Dockerfile.\n[Run Image](command:vscode-containers.images.run)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/3g-runContainers.gif","altText":"Running a container"}},{"id":"containerExplorer","title":"Use the Container Explorer","completionEvents":["onView:vscode-containers.views.containers","onCommand:workbench.view.extension.containersView"],"description":"The Container Explorer makes it easy to manage, troubleshoot, and deploy containerized applications. The Container Explorer shows a number of container resources such as containers, images, volumes, networks, and container registries.\n\nThe right-click menu provides access to commonly used commands for each resource type.\n[Open Container Explorer](command:vscode-containers.views.containers.focus)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/4g-useExplorer.gif","altText":"Using the Container Explorer"}},{"id":"pushImage","title":"Push an Image to a Container Registry","completionEvents":["onCommand:vscode-containers.images.push"],"description":"The Container Tools Extension allows you to push your container image to Docker Hub, Azure Container Registry and other registry providers.\n[Push an Image](command:vscode-containers.images.push)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/5g-pushImage.gif","altText":"Pushing an image to a container registry"}},{"id":"azDeploy","title":"Deploy to Azure App Service","completionEvents":["onCommand:vscode-containers.registries.deployImageToAzure","onCommand:vscode-containers.registries.deployImageToAca"],"description":"The Container Tools extension helps you deploy your containerized applications and take advantage of a fully-managed platform using Azure App Service. Prior to deployment, the image must be uploaded to either Azure Container Registry or Docker Hub.\n\nAfter a successful deployment, select **Open Site** in the notification. Your container is running in Azure!\n[Deploy](command:vscode-containers.registries.deployImageToAzure)","media":{"image":"https://github.com/microsoft/vscode-containers/raw/main/resources/walkthroughs/6g-deployToAppSvc.gif","altText":"Deploying to Azure App Service"}},{"id":"learn","title":"Learn More","description":"Great job! You've now completed Getting Started with Container Tools. But don't stop here! There are plenty of ways to become more proficient building containerized applications using the Container Tools extension.\n\nFor example, you can [debug a container](https://code.visualstudio.com/docs/containers/debug-common), or [run multiple containers](https://code.visualstudio.com/docs/containers/docker-compose) at once using Docker Compose.\n\nCheck out our [documentation](https://code.visualstudio.com/docs/containers/overview) to make the most of the Container Tools extension for VS Code!","completionEvents":["onStepSelected"],"media":{"markdown":"resources/walkthroughs/empty.md"}}]}],"languageModelTools":[{"name":"container-tools_get-config","tags":["containers"],"toolReferenceName":"containerToolsConfig","displayName":"Get Container Tools Configuration","modelDescription":"Gets the configuration the user has set for the container and container orchestrator (compose) CLIs, including the correct base commands to use and any environment variables that will be set. This tool **MUST** be called before generating or running any container or container orchestrator CLI commands, to ensure the correct base command is used.","userDescription":"Gets the configuration for the Container Tools extension.","canBeReferencedInPrompt":true,"icon":"$(settings-gear)"}]},"engines":{"vscode":"^1.105.0"},"capabilities":{"virtualWorkspaces":false,"untrustedWorkspaces":{"supported":"limited","description":"Workspace must be trusted in order to perform relevant container actions.","restrictedConfigurations":["containers.commands.build","containers.commands.run","containers.commands.runInteractive","containers.commands.attach","containers.commands.logs","containers.commands.composeUp","containers.commands.composeUpSubset","containers.commands.composeDown","containers.environment","containers.scaffolding.templatePath","containers.containerCommand","containers.composeCommand","containers.containerClient","containers.orchestratorClient"]}},"scripts":{"build":"npm run build:esbuild & npm run build:check","build:esbuild":"node esbuild.mjs","build:check":"tsc --noEmit","package":"vsce package","lint":"eslint --max-warnings 0","test":"vscode-test"},"extensionDependencies":["vscode.docker","vscode.yaml"],"devDependencies":{"@azure/arm-appservice":"*","@azure/arm-authorization":"*","@microsoft/vscode-azext-eng":"1.0.0-alpha.14","@types/fs-extra":"^11.0.1","@types/node":"22.x","@types/semver":"^7.3.13","@types/vscode":"1.105.0","@vscode/test-cli":"*","@vscode/test-electron":"*","@vscode/vsce":"*","esbuild":"*","esbuild-plugin-copy":"*"},"dependencies":{"@azure/arm-containerregistry":"^10.1.0","@azure/storage-blob":"^12.14.0","@microsoft/compose-language-service":"^0.5.0","@microsoft/vscode-azext-azureappservice":"^4.0.0","@microsoft/vscode-azext-azureauth":"^6.0.0-alpha.2","@microsoft/vscode-azext-azureutils":"^4.0.0","@microsoft/vscode-azext-utils":"^4.0.4","@microsoft/vscode-container-client":"^0.5.3","@microsoft/vscode-docker-registries":"^0.4.2","@microsoft/vscode-processutils":"^0.2.1","dayjs":"^1.11.7","dockerfile-language-server-nodejs":"^0.15.0","fast-xml-parser":"^5.7.1","fs-extra":"^11.1.1","gradle-to-js":"^2.0.1","handlebars":"^4.7.9","semver":"^7.5.2","tar":"^7.5.11","vscode-languageclient":"^10.0.0-next.19","vscode-tas-client":"^0.1.75","zod":"~4"}},"location":{"$mid":1,"path":"/c:/Users/imvij/.vscode/extensions/ms-azuretools.vscode-containers-2.4.4","scheme":"file"},"isBuiltin":false,"targetPlatform":"undefined","publisherDisplayName":"Microsoft","metadata":{"isApplicationScoped":false,"isMachineScoped":false,"isBuiltin":false,"installedTimestamp":1778241105008,"pinned":false,"source":"gallery","id":"2cd1d691-3d69-4d2d-ae39-fda4bc4cfd3d","publisherId":"52b787f2-79a9-4f32-99b4-393afe3005d3","publisherDisplayName":"Microsoft","targetPlatform":"undefined","updated":true,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"preRelease":false,"size":5998833},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"ms-vscode-remote.remote-containers","uuid":"93ce222b-5f6f-49b7-9ab1-a0463c6238df"},"manifest":{"name":"remote-containers","displayName":"Dev Containers","description":"Open any folder or repository inside a Docker container and take advantage of Visual Studio Code's full feature set.","version":"0.459.0","publisher":"ms-vscode-remote","icon":"resources/dev-containers.png","repository":{"type":"git","url":"https://github.com/Microsoft/vscode-remote-release.git"},"bugs":{"url":"https://github.com/Microsoft/vscode-remote-release/issues"},"license":"SEE LICENSE IN LICENSE.txt","engines":{"vscode":"^1.101.0"},"extensionKind":["ui"],"capabilities":{"untrustedWorkspaces":{"supported":"limited","description":"Opening a folder in a container requires workspace trust."},"virtualWorkspaces":true},"categories":["Other"],"keywords":["remote","docker","containers","remote development","dev container","devcontainer","development container","continueOn"],"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","activationEvents":["onStartupFinished","workspaceContains:.devcontainer/devcontainer.json","workspaceContains:.devcontainer.json","onResolveRemoteAuthority:dev-container","onResolveRemoteAuthority:attached-container","onResolveRemoteAuthority:k8s-container","onResolveRemoteAuthority:apple-container","onDebugResolve:extensionHost"],"main":"./dist/extension/extension","l10n":"./l10n","enabledApiProposals":["resolvers","tunnels","workspaceTrust","terminalDimensions","contribEditSessions","contribViewsRemote","contribRemoteHelp"],"contributes":{"continueEditSession":[{"command":"remote-containers.openRepositoryFromRemoteHubWithEditSession","group":"0_local@2","when":"!isWeb && remoteHub:hasVirtualFolders","qualifiedName":"Continue Working in Container Volume","remoteGroup":"remote_30_dev-container_2_actions@8"},{"command":"remote-containers.openRepositoryFromGitWithEditSession","group":"0_local@2","when":"git.state == initialized && gitOpenRepositoryCount != 0 && remoteName =~ /(codespaces*.*|tunnel)/ && false","qualifiedName":"Continue Working in Container Volume","remoteGroup":"remote_30_dev-container_2_actions@8"}],"languages":[{"id":"jsonc","filenames":["devcontainer-feature.json",".devcontainer-internal.json"]}],"jsonValidation":[{"fileMatch":"devcontainer-feature.json","url":"https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"}],"configuration":{"title":"Dev Containers","properties":{"remote.containers.defaultExtensions":{"scope":"application","deprecationMessage":"Use 'dev.containers.defaultExtensions' instead.","markdownDeprecationMessage":"Use `#dev.containers.defaultExtensions#` instead."},"dev.containers.defaultExtensions":{"scope":"application","type":"array","description":"Configures the list of extensions to always install while creating a container.","default":[],"items":{"type":"string","pattern":"([a-z0-9A-Z][a-z0-9\\-A-Z]*)\\.([a-z0-9A-Z][a-z0-9\\-A-Z]*)","errorMessage":"Expected format '${publisher}.${name}'. Example: 'vscode.csharp'."}},"dev.containers.defaultFeatures":{"scope":"application","type":"object","description":"Configures the list of features to always install while creating a container.","default":{}},"remote.containers.workspaceMountConsistency":{"scope":"application","deprecationMessage":"Use 'dev.containers.workspaceMountConsistency' instead.","markdownDeprecationMessage":"Use `#dev.containers.workspaceMountConsistency#` instead."},"dev.containers.workspaceMountConsistency":{"scope":"application","type":"string","enum":["consistent","cached","delegated"],"enumDescriptions":["Perfect consistency.","The host’s view is authoritative.","The container’s view is authoritative."],"description":"The consistency level used for the workspace mount (existing containers must be rebuilt to take effect).","default":"cached"},"dev.containers.gpuAvailability":{"scope":"machine","type":"string","enum":["all","detect","none"],"enumDescriptions":["All GPUs are available. This expects the host to have a GPU.","Availability should be detected automatically.","No GPUs are available."],"description":"Availability of GPUs when a dev container requires any.","default":"detect"},"remote.containers.cacheVolume":{"scope":"application","deprecationMessage":"Use 'dev.containers.cacheVolume' instead.","markdownDeprecationMessage":"Use `#dev.containers.cacheVolume#` instead."},"dev.containers.cacheVolume":{"scope":"application","type":"boolean","description":"Controls whether a Docker volume should be used to cache the VS Code server and extensions.","default":true},"remote.containers.copyGitConfig":{"scope":"machine","deprecationMessage":"Use 'dev.containers.copyGitConfig' instead.","markdownDeprecationMessage":"Use `#dev.containers.copyGitConfig#` instead."},"dev.containers.copyGitConfig":{"scope":"machine","type":"boolean","markdownDescription":"Controls whether the Git configuration (`~/.gitconfig`) should be copied into the container. This is done after installing any `#dotfiles.repository#` and will not overwrite an existing Git configuration file.","default":true},"remote.containers.gitCredentialHelperConfigLocation":{"scope":"machine","deprecationMessage":"Use 'dev.containers.gitCredentialHelperConfigLocation' instead.","markdownDeprecationMessage":"Use `#dev.containers.gitCredentialHelperConfigLocation#` instead."},"dev.containers.gitCredentialHelperConfigLocation":{"scope":"machine","type":"string","enum":["system","global","none"],"enumDescriptions":["Write to system config (`/etc/gitconfig`, requires root access).","Write to user config (`~/.gitconfig`).","Do not set a credential helper."],"description":"Where to write the configuration for the Git credential helper.","default":"global"},"dev.containers.dockerCredentialHelper":{"scope":"machine","type":"boolean","markdownDescription":"Controls whether a credential helper should be registered as the `credStore` in the Docker configuration (`~/.docker/config.json`) of dev containers. This will not overwrite an existing `credStore` entry in the configuration file.","default":true},"dev.containers.githubCLILoginWithToken":{"scope":"machine","type":"boolean","markdownDescription":"Controls whether GitHub CLI login with a token from the local GitHub CLI should be enabled in the Dev Container.","default":false},"dev.containers.mountWaylandSocket":{"scope":"application","ignoreSync":true,"type":"boolean","markdownDescription":"Controls whether a Wayland socket, if one exists, should be mounted into the Dev Container.","default":true},"remote.containers.logLevel":{"scope":"application","deprecationMessage":"Use 'dev.containers.logLevel' instead.","markdownDeprecationMessage":"Use `#dev.containers.logLevel#` instead."},"dev.containers.logLevel":{"scope":"application","type":"string","description":"The log level for the extension.","default":"debug","enum":["info","debug","trace"]},"remote.containers.dockerPath":{"scope":"application","deprecationMessage":"Use 'dev.containers.dockerPath' instead.","markdownDeprecationMessage":"Use `#dev.containers.dockerPath#` instead."},"dev.containers.dockerPath":{"scope":"application","type":"string","description":"Docker (or Podman) executable name or path.","default":"docker"},"remote.containers.dockerComposePath":{"scope":"application","deprecationMessage":"Use 'dev.containers.dockerComposePath' instead.","markdownDeprecationMessage":"Use `#dev.containers.dockerComposePath#` instead."},"dev.containers.dockerComposePath":{"scope":"application","type":"string","description":"Docker Compose executable name or path.","default":"docker-compose"},"dev.containers.dockerSocketPath":{"scope":"application","type":"string","description":"Docker socket path. Used, e.g., when connecting to a Dev Container with the devcontainer.json in a Docker Volume.","default":"/var/run/docker.sock"},"dev.containers.bootstrapImage":{"scope":"application","type":"string","description":"Docker image to use as the bootstrap container for cloning repositories into Docker volumes, and for inspect and recovery containers. When set, this image is used directly instead of building from the built-in Dockerfile. The image must include the Docker and Git CLIs, and optionally SSH, Git LFS and Node.js. When Node.js is not installed, it will be added from a VS Code Server download matching the architecture."},"dev.containers.bootstrapImagePull":{"scope":"application","type":"boolean","default":false,"description":"Automatically pull the bootstrap image before starting the bootstrap container. Only applies when a custom bootstrap image is configured."},"remote.containers.executeInWSL":{"scope":"application","deprecationMessage":"Use 'dev.containers.executeInWSL' instead.","markdownDeprecationMessage":"Use `#dev.containers.executeInWSL#` instead."},"dev.containers.executeInWSL":{"scope":"application","type":"boolean","description":"Controls whether CLI commands should always be executed in WSL. The default is to only execute in WSL for workspace folders in WSL. This setting has no effect on other platforms than Windows.","default":false},"remote.containers.executeInWSLDistro":{"scope":"application","deprecationMessage":"Use 'dev.containers.executeInWSLDistro' instead.","markdownDeprecationMessage":"Use `#dev.containers.executeInWSLDistro#` instead."},"dev.containers.executeInWSLDistro":{"scope":"application","type":"string","markdownDescription":"WSL distro to use when not reopening a WSL folder. The default is to use the default WSL distro (see `wsl -l`). This setting has no effect when `#dev.containers.executeInWSL#` is not enabled or on other platforms than Windows."},"dev.containers.forwardWSLServices":{"scope":"application","type":"boolean","description":"Controls whether services in WSL (SSH agent, GPG agent, X display, Wayland display) are forwarded into the container. This setting has no effect on other platforms than Windows.","default":true},"dotfiles.repository":{"scope":"machine","type":"string","description":"URL of a dotfiles Git repository (e.g., https://github.com/owner/repository.git) or owner/repository of a GitHub repository."},"dotfiles.installCommand":{"scope":"machine","type":"string","description":"The command to run after cloning the dotfiles repository. Defaults to run the first file of `install.sh`, `install`, `bootstrap.sh`, `bootstrap`, `setup.sh` and `setup` found in the dotfiles repository's root folder."},"dotfiles.targetPath":{"scope":"machine","type":"string","description":"The path to clone the dotfiles repository to. Defaults to `~/dotfiles`.","default":"~/dotfiles"},"remote.containers.dotfiles.repository":{"scope":"machine","deprecationMessage":"Use 'dotfiles.repository' instead.","markdownDeprecationMessage":"Use `#dotfiles.repository#` instead."},"remote.containers.dotfiles.installCommand":{"scope":"machine","deprecationMessage":"Use 'dotfiles.installCommand' instead.","markdownDeprecationMessage":"Use `#dotfiles.installCommand#` instead."},"remote.containers.dotfiles.targetPath":{"scope":"machine","deprecationMessage":"Use 'dotfiles.targetPath' instead.","markdownDeprecationMessage":"Use `#dotfiles.targetPath#` instead."},"remote.containers.repositoryConfigurationPaths":{"scope":"application","deprecationMessage":"Use 'dev.containers.repositoryConfigurationPaths' instead.","markdownDeprecationMessage":"Use `#dev.containers.repositoryConfigurationPaths#` instead."},"dev.containers.repositoryConfigurationPaths":{"scope":"application","type":"array","markdownDescription":"List of additional paths to search for [repository configurations](https://code.visualstudio.com/docs/devcontainers/create-dev-container#_alternative-repository-configuration-folders).","default":[],"items":{"type":"string"}},"dev.containers.lockfile":{"scope":"application","type":"boolean","description":"Controls whether a devcontainer-lock.json should be written.","default":true},"dev.containers.experimentalMountGitWorktreeCommonDir":{"scope":"application","type":"boolean","markdownDescription":"Mount the Git worktree common dir for Git operations to work in the container. This requires the worktree to be created with relative paths (`git worktree add --relative-paths`).","default":false,"tags":["experimental"]},"dev.containers.optimisticallyLaunchDocker":{"scope":"application","type":"boolean","description":"Optimistically attempt to start docker if the daemon is not already running.","default":true},"dev.containers.experimentalAppleContainerSupport":{"scope":"application","type":"boolean","markdownDescription":"**Experimental:** Enable support for attaching to Apple Containerization containers. Requires the `container` command to be available on macOS.","default":false,"tags":["experimental"]},"remote.serverDownloadBaseUrl":{"scope":"application","type":"string","markdownDescription":"Base URL for downloading the VS Code server. The path `/commit:{commit}/server-{platform}/{quality}` will be appended to this URL. Platforms include `linux-x64`, `linux-armhf`, `linux-arm64`, `linux-alpine`, and `alpine-arm64`. Quality is `stable` or `insider`.","default":"https://update.code.visualstudio.com","pattern":"^https?://([^:]*(:[^@]*)?@)?([^:]+|\\[[:0-9a-fA-F]+\\])(:\\d+)?(/[^?#]*)?$|^$","patternErrorMessage":"Must be a URL (e.g., https://example.com or https://example.com:8080/path)."},"remote.serverDownloadFolder":{"scope":"application","type":"string","markdownDescription":"Local folder for downloading and caching VS Code server archives. The archives will be stored as `{downlo